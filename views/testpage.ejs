<!DOCTYPE html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test- TaskFlow</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head><!-- Main Container -->
<body>

   
 <!-- Background Stays the Same -->
  
<div class="relative min-h-screen w-full bg-stone-950 flex items-center justify-center p-6 overflow-hidden">
  
  <!-- SUNSET BLOBS -->
  <div class="absolute top-[-5%] left-[-5%] w-80 h-80 bg-[#fbbf24] rounded-full blur-[100px] opacity-20"></div>
  <div class="absolute bottom-[-5%] right-[-5%] w-96 h-96 bg-[#f87171] rounded-full blur-[120px] opacity-20"></div>

  <!-- THE "IN-BETWEEN" GLASS CARD -->
  <!-- max-w-xl is the perfect middle ground between a login (max-w-md) and a hero (max-w-5xl) -->

  <!-- THE MILKY GLASS CARD -->
<!-- Using bg-white/20 for a more "white" tint and backdrop-blur-3xl for deeper frosting -->
<div class="relative z-10 w-full max-w-xl backdrop-blur-3xl bg-white/20 border border-white/30 rounded-[2.5rem] p-12 shadow-2xl text-center">
  
  <!-- Icon Area -->
  <!-- <div class="w-16 h-16 bg-gradient-to-br from-[#fbbf24] to-[#f87171] rounded-2xl mx-auto mb-8 flex items-center justify-center shadow-lg">
    <span class="text-black text-2xl font-black">TF</span>
  </div> -->

  <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-6">
    Welcome to <br />
    <span class="text-[#fbbf24]">TaskFlow</span>
  </h1>

  <p class="text-white/80 text-lg mb-10 leading-relaxed px-4">
    The modern workspace to manage your projects, track your time, and hit your goals—all in one place.
  </p>

  <div class="space-y-4 px-6">
    <button class="w-full py-4 bg-white text-black font-bold rounded-xl hover:bg-stone-200 transition-all">
      Create Your Account
    </button>
    <button class="w-full py-4 bg-white/10 text-white font-semibold rounded-xl border border-white/20 hover:bg-white/20 transition-all">
      Sign In
    </button>
  </div>
</div>

  </div>
</div>

    



